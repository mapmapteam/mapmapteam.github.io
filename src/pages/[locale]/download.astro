---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const lang = getLangFromUrl(Astro.url);

const content = await import(`../../data/${lang}/download.md`);
const Content = content.default;

const descriptions = {
  en: 'Download MapMap for free — open source projection mapping software for macOS. Source code for Windows and Linux. No registration required.',
  fr: 'Téléchargez MapMap gratuitement — logiciel libre de projection vidéo pour macOS. Code source pour Windows et Linux. Aucune inscription requise.',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MapMap',
  description: descriptions[lang],
  url: 'https://mapmapteam.github.io',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS 13 or later',
  softwareVersion: '1.0.0-beta.1',
  downloadUrl: 'https://github.com/mapmapteam/mapmap/releases/download/1.0.0-beta.1/MapMap-1.0.0-beta.1-macos-universal.dmg',
  releaseNotes: 'https://github.com/mapmapteam/mapmap/releases/tag/1.0.0-beta.1',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  license: 'https://opensource.org/licenses/GPL-3.0',
  author: {
    '@type': 'Organization',
    name: 'MapMap Team',
    url: 'https://mapmapteam.github.io',
  },
};
---

<BaseLayout
  title={lang === 'fr' ? 'Télécharger' : 'Download'}
  description={descriptions[lang]}
  jsonLd={jsonLd}
>
  <article class="prose prose-lg max-w-none">
    <Content />
  </article>
</BaseLayout>
